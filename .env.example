# Copy this file to `.env` and adjust if needed. The defaults work for local use.
# Docker Compose sets these automatically for the containerized stack.

# Where the Ollama service is reachable.
OLLAMA_HOST=http://localhost:11434

# Models (must be available to Ollama; the app pulls them automatically).
# gemma3:4b is the default for speed on CPU-only hardware: it runs the eval
# suite in ~40% of the time of larger models and fails nowhere they don't
# also fail (see report/). For deeper answers at the cost of latency, try
# CHAT_MODEL=gpt-oss:20b or CHAT_MODEL=mistral-nemo:12b.
CHAT_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text
# Routes questions to an answer mode. Defaults to CHAT_MODEL, so leaving this
# unset means one less model to download. Set it to split the roles.
# CLASSIFIER_MODEL=gemma3:4b
# Only used by evals/, never on the user-facing path, so there is no latency
# reason to hold back — use the largest model available.
JUDGE_MODEL=gpt-oss:20b
# Temperature 0 + fixed seed gives deterministic answers for a RAG app.
CHAT_TEMPERATURE=0
CHAT_SEED=42

# Embedding request timeout (seconds). Raised above the client default (60s)
# because CPU-only embedding of a large batch of chunks can take longer.
EMBED_TIMEOUT=300

# Chroma vector store.
# Leave CHROMA_HOST unset for a local persistent store at CHROMA_PERSIST_DIR.
# Set CHROMA_HOST/CHROMA_PORT to use a Chroma server (the Docker stack does this).
# CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=chroma_db

# Folder holding source documents to ingest.
DOCUMENTS_DIR=data/documents
