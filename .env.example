# Copy this file to `.env` and adjust if needed. The defaults work for local use.
# Docker Compose sets these automatically for the containerized stack.

# Where the Ollama service is reachable.
OLLAMA_HOST=http://localhost:11434

# Models (must be available to Ollama; the app pulls them automatically).
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
# Temperature 0 gives deterministic answers, which is correct for a RAG app.
CHAT_TEMPERATURE=0

# Chroma vector store.
# Leave CHROMA_HOST unset for a local persistent store at CHROMA_PERSIST_DIR.
# Set CHROMA_HOST/CHROMA_PORT to use a Chroma server (the Docker stack does this).
# CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=chroma_db

# Folder holding source documents to ingest.
DOCUMENTS_DIR=data/documents
